{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KL4A Workbench",
  "version": "0.1.0",
  "identifier": "ai.cogniswitch.sopkb.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KL4A Workbench",
        "width": 1440.0,
        "height": 900.0,
        "minWidth": 880.0,
        "minHeight": 600.0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
