@prefix sopkb: <https://example.org/sopkb/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

sopkb:concept_report a sopkb:Concept ;
  rdfs:label "Report" .

sopkb:object_staff_must_confirm_the_report_contents_before_filing a sopkb:RelationObject ;
  rdfs:label "Staff must confirm the report contents before filing." ;
  sopkb:objectText "Staff must confirm the report contents before filing." .

sopkb:kr_ki_report_v1_000001 a sopkb:KnowledgeRelation ;
  sopkb:subject sopkb:concept_report ;
  sopkb:predicate sopkb:predicate_requires ;
  sopkb:object sopkb:object_staff_must_confirm_the_report_contents_before_filing ;
  sopkb:knowledgePiece sopkb:ki_report_v1_000001 ;
  sopkb:evidence sopkb:evidence_ki_report_v1_000001 ;
  dcterms:source "report" ;
  sopkb:sourceVersion "report:v1" ;
  sopkb:reviewStatus "proposed" .

sopkb:concept_report sopkb:predicate_requires sopkb:object_staff_must_confirm_the_report_contents_before_filing .

sopkb:rule_ki_report_v1_000001_requires a sopkb:DecisionRule ;
  rdfs:label "Report" ;
  sopkb:knowledgePiece sopkb:ki_report_v1_000001 ;
  sopkb:knowledgeRelation sopkb:kr_ki_report_v1_000001 ;
  sopkb:evidence sopkb:evidence_ki_report_v1_000001 ;
  sopkb:conditionFact "always" ;
  sopkb:obligationFact "scenario_mentions_report" ;
  sopkb:otherwiseActionRequired "true" .
