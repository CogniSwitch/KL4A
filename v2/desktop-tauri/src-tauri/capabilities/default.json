{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Grants the main window access to every PORT_PLAN.md §4 app command plus the dialog/opener plugins it needs (native folder/file pickers, revealing an export path in the OS file manager). The frontend is now the bundled `frontendDist` build loaded locally (no more remote HTTP sidecar origin), so this capability is local-only -- no `remote` grant.",
  "local": true,
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",

    "allow-get-workbench-context",
    "allow-resolve-launch-target",
    "allow-set-workbench-root",
    "allow-pick-workbench-folder",
    "allow-select-bundle",
    "allow-deselect-bundle",

    "allow-list-bundles",
    "allow-create-project",
    "allow-describe-bundle",
    "allow-init-bundle",
    "allow-delete-bundle",
    "allow-repair-bundle-dirs",
    "allow-get-legacy-state-status",
    "allow-get-bundle-prompt-overrides",
    "allow-set-bundle-prompt-overrides",

    "allow-pick-source-files",
    "allow-pick-source-folder",
    "allow-stage-source-files",
    "allow-get-staged-sources",
    "allow-clear-staged-sources",
    "allow-remove-staged-source",
    "allow-run-ingest-pipeline",
    "allow-cancel-ingest",
    "allow-get-last-ingest-run",
    "allow-preview-ingest-pipeline",
    "allow-retire-source",
    "allow-scan-sources",
    "allow-normalize-sources",
    "allow-mine-knowledge",
    "allow-validate-bundle",

    "allow-list-sources",
    "allow-get-source",
    "allow-get-normalized-text",
    "allow-get-source-stats",
    "allow-list-sections",
    "allow-get-section",
    "allow-list-knowledge-items",
    "allow-get-knowledge-item",
    "allow-search-knowledge",
    "allow-get-evidence",
    "allow-resolve-citation",
    "allow-get-concept-index",
    "allow-get-concept-detail",
    "allow-get-review-detail",
    "allow-get-graph",
    "allow-get-reports",
    "allow-get-validation-summary",
    "allow-get-conflicts-report",
    "allow-get-freshness-report",
    "allow-get-agent-guide",
    "allow-list-authored-drafts",
    "allow-get-authored-draft",

    "allow-approve-item",
    "allow-reject-item",
    "allow-defer-item",
    "allow-comment-item",
    "allow-edit-item",
    "allow-list-review-events",

    "allow-list-agent-tasks",
    "allow-get-agent-transcript",
    "allow-run-agent-chat",
    "allow-get-task-context",
    "allow-get-scenario-context",
    "allow-clear-agent-transcript",
    "allow-delete-agent-chat",

    "allow-sync-okf-documents",
    "allow-get-export-dir",
    "allow-reveal-path",

    "allow-get-settings",
    "allow-get-default-prompts",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-set-default-profile",
    "allow-set-reviewer-name",
    "allow-set-max-parallel-workers",
    "allow-test-profile-connection",

    "allow-search-relations",
    "allow-get-relation-neighborhood",

    "allow-get-mcp-invocation",
    "allow-list-mcp-client-targets",
    "allow-rescan-mcp-client-targets",
    "allow-configure-mcp-client",

    "allow-export-diagnostics-bundle"
  ]
}
