sopkb:concept_document sopkb:predicate_requires sopkb:object_staff_must_confirm_patient_identity_before_proceeding .

sopkb:rule_ki_bom_doc_v1_000001_confirm_patient_identity a sopkb:DecisionRule ;
  rdfs:label "Confirm patient identity" ;
  sopkb:knowledgePiece sopkb:ki_bom_doc_v1_000001 ;
