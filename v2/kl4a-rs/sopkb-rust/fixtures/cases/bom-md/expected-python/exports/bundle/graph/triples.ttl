sopkb:concept_document a sopkb:Concept ;
  rdfs:label "Document" .

sopkb:object_staff_must_confirm_patient_identity_before_proceeding a sopkb:RelationObject ;
  rdfs:label "Staff must confirm patient identity before proceeding." ;
  sopkb:objectText "Staff must confirm patient identity before proceeding." .

sopkb:kr_ki_bom_doc_v1_000001 a sopkb:KnowledgeRelation ;
  sopkb:subject sopkb:concept_document ;
  sopkb:predicate sopkb:predicate_requires ;
  sopkb:object sopkb:object_staff_must_confirm_patient_identity_before_proceeding ;
  sopkb:knowledgePiece sopkb:ki_bom_doc_v1_000001 ;
